# Основний шлях: ключ Anthropic, base_url лишається порожнім
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Альтернатива: QwenCloud говорить Anthropic-протоколом, код той самий.
# Тоді ANTHROPIC_API_KEY — ключ QwenCloud, а base_url і модель такі:
#   ANTHROPIC_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic
#   ANTHROPIC_MODEL=qwen3.8-max

MONO_TOKEN=

MAX_TOKENS=1500
MAX_TURNS=6
HTTP_TIMEOUT=20
TOOLS_VARIANT=v2

# База знань: локальна модель ембедингів, ключа не потребує
EMBED_MODEL=intfloat/multilingual-e5-large
EMBED_BATCH=32
CHUNK_CHARS=400
CHUNK_MAX=1200
PARENT_CHARS=1600
TOP_K=5
MIN_SCORE=0.83
RAG_VARIANT=guarded
